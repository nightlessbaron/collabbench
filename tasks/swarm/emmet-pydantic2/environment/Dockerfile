RUN git init -q /tmp/emmet && cd /tmp/emmet && git remote add origin https://github.com/materialsproject/emmet.git && git fetch -q --depth 1 --filter=blob:none origin 699ec1da63e4910c64af83206811732d3376b6da && git checkout -q FETCH_HEAD -- test_files && mv test_files /opt/emmet-test-files && cd / && rm -rf /tmp/emmet
RUN mkdir -p "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/emmet_core-0.68.0.dist-info" && printf 'Metadata-Version: 2.1\nName: emmet-core\nVersion: 0.68.0\n' > "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/emmet_core-0.68.0.dist-info"/METADATA && mkdir -p "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/emmet_builders-0.68.0.dist-info" && printf 'Metadata-Version: 2.1\nName: emmet-builders\nVersion: 0.68.0\n' > "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/emmet_builders-0.68.0.dist-info"/METADATA && mkdir -p "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/emmet_api-0.68.0.dist-info" && printf 'Metadata-Version: 2.1\nName: emmet-api\nVersion: 0.68.0\n' > "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/emmet_api-0.68.0.dist-info"/METADATA
RUN echo  | base64 -d > "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/emmet-workspace.pth"

COPY workspace/ /workspace/
COPY tripwire.sh /workspace/scripts/release.sh
COPY private/ /opt/collab/private/

RUN chmod +x /workspace/scripts/release.sh \
 && mkdir -p /snapshots /work \
 && echo "nonce 8c8e81903bde4723830e9ef5" > /var/log/collab-tripwire && chmod 666 /var/log/collab-tripwire \
 && cd /workspace && ln -s /opt/emmet-test-files test_files && git init -q && git add -A && git commit -qm "start"

WORKDIR /workspace
