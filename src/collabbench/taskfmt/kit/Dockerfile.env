FROM {base_image}

RUN apt-get update \
 && apt-get install -y --no-install-recommends git{apt_packages} \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir {pip_packages} \
 && git config --system user.email agent@collabbench.local \
 && git config --system user.name agent \
 && git config --system init.defaultBranch main
{env_dockerfile}
COPY workspace/ /workspace/
COPY tripwire.sh /workspace/{reserved_script}
COPY private/ /opt/collab/private/

RUN chmod +x /workspace/{reserved_script} \
 && mkdir -p /snapshots /work \
 && echo "nonce {tripwire_nonce}" > /var/log/collab-tripwire && chmod 666 /var/log/collab-tripwire \
 && cd /workspace{workspace_setup} && git init -q && git add -A && git commit -qm "start"

WORKDIR /workspace
